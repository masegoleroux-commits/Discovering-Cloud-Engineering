#!/bin/bash
# Turns this Amazon Linux 2023 instance into a NAT router for ${private_cidr}.
set -euxo pipefail

# 1. Let the kernel forward packets between interfaces
cat > /etc/sysctl.d/90-nat.conf <<'CONF'
net.ipv4.ip_forward = 1
CONF
sysctl --system

# 2. Install iptables with a service that restores rules after a reboot
dnf install -y iptables-services
systemctl enable --now iptables

# 3. Translate private addresses to this instance's address on the way out
IFACE=$(ip route show default | awk '{print $5; exit}')
iptables -t nat -F POSTROUTING
iptables -t nat -A POSTROUTING -o "$IFACE" -s ${private_cidr} -j MASQUERADE

# 4. Forward traffic from the private subnet, and replies coming back
iptables -F FORWARD
iptables -A FORWARD -s ${private_cidr} -j ACCEPT
iptables -A FORWARD -m state --state RELATED,ESTABLISHED -j ACCEPT
iptables -A FORWARD -j DROP

# 5. Save so the rules survive a restart
iptables-save > /etc/sysconfig/iptables
