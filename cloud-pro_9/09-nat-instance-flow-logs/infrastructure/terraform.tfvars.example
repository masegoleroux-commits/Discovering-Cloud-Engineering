# Copy to terraform.tfvars (which git ignores) and fill in.
owner       = "your-github-handle"
alert_email = "you@example.com"

# If AWS says "InsufficientInstanceCapacity" in eu-north-1a, use another zone: 1 = eu-north-1b, 2 = eu-north-1c
# az_index = 1

# If AWS has no t4g.micro capacity in ANY zone, use the x86 Free Tier size instead (the right image is picked for you):
# nat_instance_type = "t3.micro"
# app_instance_type = "t3.micro"
